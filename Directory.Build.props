<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- Lets the portable projects (and the CI Linux job) build Windows-targeting code paths. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Work to Unlock</Company>
    <Product>Work to Unlock</Product>
    <Copyright>Copyright (c) Work to Unlock contributors</Copyright>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>
</Project>
