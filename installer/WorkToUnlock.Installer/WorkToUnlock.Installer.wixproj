<Project Sdk="WixToolset.Sdk/6.0.2">

  <!-- Builds the per-machine MSI from a publish folder produced by build/Publish.ps1. -->
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-$(Platform.ToLowerInvariant())\</PublishDir>
    <!-- PublishDir may arrive as a global property (which cannot be reassigned), so normalize into a separate one. -->
    <HarvestDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</HarvestDir>
    <OutputName>WorkToUnlock-$(ProductVersion)-$(Platform.ToLowerInvariant())</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\installer\</OutputPath>
    <DefineConstants>PublishDir=$(HarvestDir);ProductVersion=$(ProductVersion);AssetsDir=$(MSBuildThisFileDirectory)..\..\assets\icons</DefineConstants>
    <!-- Targeted ICE suppressions (all other validation stays on):
         ICE03/ICE60: Windows App SDK binaries carry multi-language version resources the File.Language column cannot hold.
         ICE38/ICE43/ICE57: per-machine Start-menu shortcut with an HKLM key path (the ICEs assume a per-user shortcut).
         ICE61: major upgrade without an upper version bound, by design (allows reinstalling the same version). -->
    <SuppressIces>ICE03;ICE38;ICE43;ICE57;ICE60;ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
