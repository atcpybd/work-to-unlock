<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window. Targets plain net10.0 so the orchestration can be unit tested on Linux;
         Windows-only code paths are annotated with [SupportedOSPlatform("windows")]. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WorkToUnlock.Agent</RootNamespace>
    <AssemblyName>WorkToUnlock.Agent</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\app.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkToUnlock.Core\WorkToUnlock.Core.csproj" />
    <ProjectReference Include="..\WorkToUnlock.Infrastructure\WorkToUnlock.Infrastructure.csproj" />
    <ProjectReference Include="..\WorkToUnlock.Enforcement\WorkToUnlock.Enforcement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\icons\tray-*.ico" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorkToUnlock.Agent.Tests" />
    <InternalsVisibleTo Include="WorkToUnlock.IntegrationTests" />
  </ItemGroup>

</Project>
