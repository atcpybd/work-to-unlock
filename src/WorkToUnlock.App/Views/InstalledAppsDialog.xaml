<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WorkToUnlock.App.Views.InstalledAppsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ipc="using:WorkToUnlock.Core.Ipc"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Choose an installed application"
    PrimaryButtonText="Choose"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12" MinWidth="460">
        <TextBox x:Name="SearchBox" PlaceholderText="Search" TextChanged="OnSearchChanged" AutomationProperties.Name="Search installed applications" />
        <ListView x:Name="AppsList" Height="380" SelectionMode="Single" SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="ipc:InstalledApplication">
                    <StackPanel Padding="0,6" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ExecutablePath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
