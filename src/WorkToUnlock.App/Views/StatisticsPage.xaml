<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WorkToUnlock.App.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WorkToUnlock.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="16">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Statistics" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Qualifying time in approved apps. Calculated and stored only on this PC." />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{x:Bind ViewModel.LoadCommand}" AutomationProperties.Name="Refresh">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="Statistics unavailable" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Metrics}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200" MinItemHeight="120" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{x:Bind Value, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Last 14 days" AutomationProperties.HeadingLevel="Level2" Margin="0" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Highlighted days reached your daily goal." />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Days}" Height="190" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayBarViewModel">
                                <Grid Width="40" ToolTipService.ToolTip="{x:Bind ToolTip}" AutomationProperties.Name="{x:Bind ToolTip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Width="26" Height="{x:Bind BarHeight}" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind GoalMet}" />
                                    <Rectangle Width="26" Height="{x:Bind BarHeight}" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" Visibility="{x:Bind GoalMissed}" />
                                    <TextBlock Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Label}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Achievements" AutomationProperties.HeadingLevel="Level2" Margin="0" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.AchievementsSummary, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Achievements}" Margin="0,4,0,0">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="240" MinItemHeight="104" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AchievementViewModel">
                                <Grid Padding="12" ColumnSpacing="12" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="{x:Bind Opacity}"
                                      ToolTipService.ToolTip="{x:Bind ToolTip}" AutomationProperties.Name="{x:Bind ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" VerticalAlignment="Top">
                                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind Unlocked}" />
                                        <Ellipse Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" Visibility="{x:Bind Locked}" />
                                        <FontIcon FontSize="18" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind StatusText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Honesty report" AutomationProperties.HeadingLevel="Level2" Margin="0" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Times when locked apps were not being blocked: Work to Unlock closed or ended from Task Manager, enforcement turned off, or a restricted app turned off or removed. Signing out and shutting down don't count." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <FontIcon FontSize="20" Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.HonestyIsClean, Mode=OneWay}" />
                        <FontIcon FontSize="20" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind ViewModel.HonestyHasIssues, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.HonestyHeadline, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.AgentStopsText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.EnforcementOffText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.AppsAllowedText, Mode=OneWay}" TextWrapping="Wrap" />
                    <InfoBar IsOpen="{x:Bind ViewModel.EnforcementOffNow, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="Enforcement is off right now. Turn it back on in Settings." />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasAppsAllowedNow, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.AppsAllowedNowText, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Incidents}" IsTabStop="False" Visibility="{x:Bind ViewModel.HonestyHasIssues, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IncidentViewModel">
                                <Grid Padding="0,4" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind WhenText}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind KindText}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{x:Bind DurationText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Work by application this week" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="No qualifying work recorded this week yet." Visibility="{x:Bind ViewModel.HasNoApplications, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Applications}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApplicationBarViewModel">
                                <Grid Padding="0,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" VerticalAlignment="Center" Maximum="100" Value="{x:Bind Percent}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind TimeText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
