<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional elevated Windows service for strict (AppLocker) enforcement. Installed only when the user selects the
       feature, and inactive until an administrator explicitly enables strict mode. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WorkToUnlock.Service</RootNamespace>
    <AssemblyName>WorkToUnlock.Service</AssemblyName>
    <ApplicationIcon>..\..\assets\icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkToUnlock.Core\WorkToUnlock.Core.csproj" />
    <ProjectReference Include="..\WorkToUnlock.Infrastructure\WorkToUnlock.Infrastructure.csproj" />
    <ProjectReference Include="..\WorkToUnlock.Enforcement\WorkToUnlock.Enforcement.csproj" />
  </ItemGroup>

</Project>
