<Project Sdk="Microsoft.NET.Sdk">

  <!-- A harmless stand-in for a "restricted app" used by the Windows integration tests, so automated
       tests never close real user applications. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
